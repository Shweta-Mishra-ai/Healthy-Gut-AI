# --- LLM Providers: at least one recommended, all optional (mock mode works without any) ---
# Groq: free tier, fast, OpenAI-compatible. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter: free-tier fallback models. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI: optional paid fallback (highest quality, last resort by cost)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Reliability ---
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_BASE=1.5

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=10

# --- Caching ---
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# --- Batch ---
MAX_BATCH_SIZE=10
BATCH_CONCURRENCY=3

# --- API access control (optional) ---
# If set, /generate, /generate/batch, /export/docx, /export/pdf, and /debug
# require an "X-API-Key" header matching this value. Leave blank to keep
# the API open (fine for a private demo; set this before public exposure).
API_KEY=

# --- Persistent storage ---
# SQLite file path for review history + dashboard data. On ephemeral-disk
# hosts (e.g. Render free tier) this resets on every restart/redeploy —
# see README "Known Limitations" for what it does and doesn't guarantee.
DATABASE_PATH=healthy_gut_ai.db

# --- WordPress publishing (optional) ---
# Leave blank to skip — dry-run publishing (no real site needed) still works.
# App Password is generated under Users > Profile > Application Passwords
# in WP admin — NOT your account login password.
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_TIMEOUT_SECONDS=15

# --- Misc ---
LOG_LEVEL=INFO
CORS_ORIGINS=*
PORT=8000
